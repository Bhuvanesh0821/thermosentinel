# =============================================================================
# ThermoSentinel - backend configuration
# Copy to `.env` in this folder (thermosentinel/.env) and fill in the secrets.
# `.env` is git-ignored. Never commit real credentials, never expose them to the frontend.
# =============================================================================

# --- Required ----------------------------------------------------------------
# Neon PostgreSQL connection string (Neon console -> your project -> Connect).
# Use the direct or pooled endpoint; keep sslmode=require. PostGIS is enabled automatically.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Recommended ------------------------------------------------------------
# NASA FIRMS MAP_KEY (free: https://firms.modaps.eosdis.nasa.gov/api/map_key/).
# With a key: region-exact Area API + history backfill. Without: the keyless public NRT feed
# (South Asia, last 7 days) is used and clipped to India. Both are real NASA data.
NASA_FIRMS_MAP_KEY=

# --- Application --------------------------------------------------------------
APP_ENV=development                  # development | production
LOG_LEVEL=INFO
LOG_FORMAT=json                      # json | text
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
AUTO_MIGRATE=true                    # apply SQL migrations on API start-up
SCHEDULER_ENABLED=true               # run ingestion + analysis in the background
# Protects POST /api/pipeline/run. Required in production (>= 24 characters); optional in development.
ADMIN_API_TOKEN=
# Production: public URLs of the deployed frontend (Vercel) and API (Render). FRONTEND_URL is
# always an allowed browser origin (CORS + WebSocket) and is used for links in alert e-mails.
FRONTEND_URL=
BACKEND_URL=
# Seconds between database retries while Neon is unreachable at start-up.
DB_STARTUP_RETRY_SECONDS=60
# live (default) | test-fixture. test-fixture replays a labelled FIRMS sample and is only
# allowed on a separate database whose name ends in _test, never in production.
DATA_MODE=live

# --- Region (India only) --------------------------------------------------------
# Data is clipped to India's official-claim boundary + EEZ from this file
# (built by data_pipeline/build_india_boundary.py). Do not change for the SIH build.
REGION_NAME=India
# REGION_BOUNDARY_FILE=database/boundaries/india_monitoring_area.geojson
# REGION_BBOX=                       # optional fetch-extent override: west,south,east,north

# --- NASA FIRMS -----------------------------------------------------------------
FIRMS_PRODUCTS=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT
FIRMS_DAY_RANGE=2                    # API mode: days per scheduled request (1-5)
FIRMS_BACKFILL_DAYS=10               # API mode: history fetched on the first run
FIRMS_PUBLIC_FEED_REGION=South_Asia  # keyless mode
FIRMS_PUBLIC_FEED_WINDOW=7d          # 24h | 48h | 7d
FIRMS_POLL_MINUTES=60

# --- OpenStreetMap / Overpass ---------------------------------------------------
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
OVERPASS_TILE_DEG=6
OVERPASS_TIMEOUT_S=180
OVERPASS_CONCURRENCY=2               # parallel tiles (public servers allow 4 slots per client)
FACILITIES_REFRESH_HOURS=168

# --- Land cover (ESA WorldCover 10 m v200) ------------------------------------------
LANDCOVER_ENABLED=true
LANDCOVER_SAMPLE_RADIUS_M=250
LANDCOVER_TARGET_RESOLUTION_M=40
LANDCOVER_MAX_SAMPLES_PER_RUN=300
LANDCOVER_WORKERS=6

# --- Analytics --------------------------------------------------------------------
CLUSTER_EPS_KM=1.5
CLUSTER_MAX_GAP_HOURS=72
CLUSTER_MIN_SAMPLES=1
CLUSTER_WINDOW_DAYS=10
PERSISTENCE_RADIUS_M=1000
PERSISTENCE_LOOKBACK_DAYS=30
PERSISTENCE_MIN_DAYS_PERSISTENT=5
PERSISTENCE_MIN_COVERAGE_DAYS=5
PERSISTENCE_MIN_RATIO=0.25
PROXIMITY_SEARCH_RADIUS_M=10000
PROXIMITY_NEAR_M=1000
PROXIMITY_ASSOC_M=3000

# --- Incidents, alerts, notifications --------------------------------------------------
INCIDENT_MIN_SCORE=40
ALERT_MIN_PRIORITY=medium            # low | medium | high | critical
# Alert rules (thresholds are evaluated on real FIRMS evidence; see /api/alerts/rules).
ALERT_RULE_HIGH_FRP_MW=50            # high intensity: peak FRP in last 24 h
ALERT_RULE_REPEAT_MIN_24H=5          # repeated observations: detections in last 24 h
ALERT_RULE_SPIKE_FACTOR=3.0          # unusual activity: 24 h detections vs the location's daily baseline
ALERT_RULE_SPIKE_MIN_24H=4
ALERT_RULE_HIGH_CONFIDENCE_MIN_FRP=10
# Comma-separated rule keys to switch off, e.g. high_confidence,repeated_observations
ALERT_RULES_DISABLED=
# Event classifier. Only the transparent rule-based baseline exists today; a trained model must be
# registered in app/analytics/classifier.py before it can be selected here.
CLASSIFIER=rules

# Optional JSON webhook for alerts (Slack/Teams/automation). Leave empty to disable.
# (Keep comments on their own line when a value is empty - dotenv would read them as the value.)
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_MIN_SEVERITY=high
# Optional e-mail alerts via SMTP. Credentials stay on the server; leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Comma-separated recipients
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_MIN_SEVERITY=high

# --- Search / voice "zoom to <place>" geocoding (OSM Nominatim, 1 request/s, results clipped to India)
GEOCODER_ENABLED=true
GEOCODER_URL=https://nominatim.openstreetmap.org/search

# --- Storage (Neon free tier: 0.5 GB per project) ------------------------------------
OBSERVATION_RETENTION_DAYS=120
