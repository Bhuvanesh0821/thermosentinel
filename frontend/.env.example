# Frontend configuration (public, non-secret values only - everything here ships to the browser).

# Where the dev server proxies /api requests (the FastAPI backend).
VITE_DEV_API_PROXY=http://127.0.0.1:8000

# Absolute API origin for production builds served separately from the API.
# Leave empty when the UI and API share an origin (reverse proxy) or in development.
VITE_API_BASE_URL=
